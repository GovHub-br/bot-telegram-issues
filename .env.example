# Token do bot, gerado pelo @BotFather (/newbot)
TELEGRAM_TOKEN=123456789:AAH...

# Token fine-grained do GitHub (dono: a organização) com "Issues: Read and write"
# nos repositórios e "Projects: Read and write" na organização
GITHUB_TOKEN=github_pat_...

# Organização do GitHub. O bot lista, busca e cria issues nos repositórios dela.
GITHUB_ORG=GovHub-br

# Opcional: limitar a alguns repositórios (separados por vírgula).
# Vazio = todos os repositórios com issues ativadas que o token enxerga.
GITHUB_REPOS=

# Quem pode usar o bot: "*" libera qualquer pessoa, ou IDs do Telegram separados
# por vírgula. Mande /start para o bot que ele responde com o seu ID.
ALLOWED_USERS=

# Opcional: IDs de grupos cujos membros podem usar o bot (IDs de grupo são negativos).
# O /start mandado dentro do grupo mostra o ID dele.
ALLOWED_CHATS=

# Labels já marcadas ao criar uma issue (separadas por vírgula). Toda issue precisa
# de pelo menos uma label.
DEFAULT_LABELS=arquitetura
# Templates de issue (.github/ISSUE_TEMPLATE) usados quando o repositorio escolhido nao tem os seus
ISSUE_TEMPLATES_REPO=data-application-cidades

# Rascunho assistido (/nova): endpoint do Hayhooks. Vazio = /nova só no modo manual.
# No docker compose este valor é substituído por http://hayhooks:1416.
HAYHOOKS_URL=http://localhost:1416

# Usados pelo Agent do Hayhooks (o bot não fala direto com o Ollama)
OLLAMA_URL=http://10.0.0.10:11434
OLLAMA_MODEL=qwen3.8:27b-mlx
# OLLAMA_TIMEOUT=120
# DRAFT_MAX_STEPS=5

# GitHub Project (v2) da organização onde as issues novas entram, e a coluna Status inicial.
# O token precisa de "Organization permissions → Projects: Read and write".
GITHUB_PROJECT=GovHub-br/4
PROJECT_STATUS="Project Backlog"

# Opcional: DEBUG, INFO, WARNING
# LOG_LEVEL=INFO
